rules_version = '2';

// -----------------------------------------------------------------------
// The admin UID below (RcQgwLcHVZTGxW6U9zK3F0bcY872) is the one admin
// account created in Firebase Authentication → Users. If you ever
// recreate that account, its UID will change — update it here too.
// -----------------------------------------------------------------------
service cloud.firestore {
  match /databases/{database}/documents {

    // Master stock data, uploaded by the admin.
    // - Any signed-in user (anonymous or admin) can read it.
    // - Only the admin's UID can create/update/delete it.
    match /masterStock/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == "RcQgwLcHVZTGxW6U9zK3F0bcY872";
    }

    // Each user's own private stock-take entries.
    // Uses the recursive {path=**} form — required for admin.html's
    // collectionGroup('entries') query to actually be covered by this
    // rule (a fixed-depth match like /users/{userId}/entries/{entryId}
    // is not reliably applied to collection-group list/query requests).
    //
    // - A user can always read/write/delete their own entries.
    // - The admin can read everyone's entries (to review submissions),
    //   and can also delete a user's entries (admin.html "Delete" button).
    match /{path=**}/entries/{entryId} {
      allow read: if request.auth != null &&
        (path[1] == request.auth.uid || request.auth.uid == "RcQgwLcHVZTGxW6U9zK3F0bcY872");
      allow create, update: if request.auth != null && path[1] == request.auth.uid;
      allow delete: if request.auth != null &&
        (path[1] == request.auth.uid || request.auth.uid == "RcQgwLcHVZTGxW6U9zK3F0bcY872");
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
