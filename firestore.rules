rules_version = '2';

// -----------------------------------------------------------------------
// The admin UID below (RcQgwLcHVZTGxW6U9zK3F0bcY872) is the one admin
// account created in Firebase Authentication → Users. If you ever
// recreate that account, its UID will change — update it here too.
// -----------------------------------------------------------------------
service cloud.firestore {
  match /databases/{database}/documents {

    // Master stock data, uploaded by the admin.
    // - Any signed-in user (anonymous or admin) can read it.
    // - Only the admin's UID can create/update/delete it.
    match /masterStock/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == "RcQgwLcHVZTGxW6U9zK3F0bcY872";
    }

    // Each user's own private stock-take entries.
    // request.auth.uid == userId is the actual enforcement: a user can
    // only read/write documents under their own uid, never anyone else's.
    match /users/{userId}/entries/{entryId} {
      allow read, create, update, delete: if request.auth != null && request.auth.uid == userId;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
