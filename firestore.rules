rules_version = '2';

// -----------------------------------------------------------------------
// The admin UID below (RcQgwLcHVZTGxW6U9zK3F0bcY872) is the one admin
// account created in Firebase Authentication → Users. If you ever
// recreate that account, its UID will change — update it here too.
//
// These rules are the real security boundary. The pages only hide buttons;
// Google's servers enforce everything below on every request.
// -----------------------------------------------------------------------
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }
    function isAdmin()    { return request.auth != null && request.auth.uid == "RcQgwLcHVZTGxW6U9zK3F0bcY872"; }
    function isOwner(userId) { return request.auth != null && request.auth.uid == userId; }
    function validQty(v)  { return v is number && v >= 0 && v <= 1000000000; }   // no negative / absurd quantities

    // A counter's saved count for ONE product. The document id must equal the
    // productId, every field is type-checked, and the uid must be the writer's.
    function validEntry(userId, entryId) {
      let d = request.resource.data;
      return d.keys().hasOnly(['productId', 'details', 'numItems', 'cartons', 'pieces', 'total', 'uid', 'updatedAt'])
        && d.keys().hasAll(['productId', 'details', 'numItems', 'cartons', 'pieces', 'total', 'uid', 'updatedAt'])
        && d.productId is string && d.productId == entryId
        && d.details is string && d.details.size() > 0 && d.details.size() <= 300
        && validQty(d.numItems) && validQty(d.cartons) && validQty(d.pieces) && validQty(d.total)
        && d.uid == userId
        && d.updatedAt is number;
    }

    // Master stock list (expected quantities), uploaded by the admin.
    // - Any signed-in user (anonymous counters or the admin) can read it.
    // - ONLY the admin's UID can create / replace / delete it.
    match /masterStock/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // A counter's profile (display name only) and their private entries.
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();                       // admin sees the list of counters
      allow create, update: if isOwner(userId)
        && request.resource.data.keys().hasOnly(['name', 'uid', 'updatedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 60
        && request.resource.data.uid == userId
        && request.resource.data.updatedAt is number;
      allow delete: if isAdmin();

      match /entries/{entryId} {
        // A counter reads / writes ONLY their own entries. Nobody else can — except the admin.
        allow get, list: if isOwner(userId) || isAdmin();
        allow create, update: if isOwner(userId) && validEntry(userId, entryId);
        allow delete: if isOwner(userId) || isAdmin();   // admin can reset a counter's entries
      }
    }

    // Lets the admin's collectionGroup('entries') query (all counters at once) work.
    // READ ONLY and ADMIN ONLY — normal users get nothing from this rule.
    match /{path=**}/entries/{entryId} {
      allow read: if isAdmin();
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
